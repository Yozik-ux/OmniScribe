# Скопіюй цей файл у .env і встав свої ключі.
# .env у .gitignore — він НІКОЛИ не має потрапляти в репозиторій.

# ================= КЛЮЧІ =================
# https://console.groq.com/keys — розпізнавання мовлення (Whisper)
GROQ_API_KEY=
# https://console.anthropic.com/settings/keys — оформлення конспекту (Claude)
ANTHROPIC_API_KEY=

# ================= ВИГЛЯД =================
# dark | light
OMNISCRIBE_THEME=dark

# ================= МОДЕЛІ =================
CONSPEKT_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max — для запису наживо тримай low/medium
CONSPEKT_EFFORT=low
CONSPEKT_WHISPER_MODEL=whisper-large-v3
CONSPEKT_LANGUAGE=uk
# detailed | concise | exam
CONSPEKT_PRESET=detailed

# ================= АУДІО =================
CONSPEKT_SAMPLE_RATE=16000
CONSPEKT_QUEUE_MAX=16
